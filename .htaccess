<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't rewrite existing files/directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route requests to Laravel public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
