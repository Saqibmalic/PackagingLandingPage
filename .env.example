APP_NAME="Custom Boxes Experts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="website@customboxesexperts.com"
MAIL_FROM_NAME="${APP_NAME} Website"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Custom Boxes Experts ──────────────────────────────────────────────
# Where new lead alerts are emailed. CC takes a comma-separated list.
LEADS_NOTIFY_TO=info@customboxesexperts.com
LEADS_NOTIFY_CC=

# Google Ads / GA4. Empty values render no tag at all.
GOOGLE_ADS_ID=
GA4_MEASUREMENT_ID=
GOOGLE_ADS_LEAD_LABEL=
GOOGLE_ADS_CALL_LABEL=

# Offline conversion imports. ADS_CONVERSION_NAME must match the conversion
# action in Google Ads exactly, and ADS_TIMEZONE the Google Ads account's
# time zone — not the server's.
ADS_CONVERSION_NAME="Quote Form Submit"
ADS_TIMEZONE=America/New_York
ADS_CURRENCY=USD
ADS_DEFAULT_VALUE=0

# Leads dashboard. Set DASHBOARD_DEMO_MODE=false before live traffic, or any
# username and password will sign in.
DASHBOARD_DEMO_MODE=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=boxes123
DASHBOARD_USER_NAME=Sales
DASHBOARD_USER_EMAIL=info@customboxesexperts.com
